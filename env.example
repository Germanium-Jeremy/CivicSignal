# CivicSignal Environment Configuration
# Copy this file to .env.local for development

# ===============================================
# DATABASE
# ===============================================
MONGODB_URI=mongodb://localhost:27017/civicsignal
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/civicsignal?retryWrites=true&w=majority

# ===============================================
# JWT SECRETS
# ===============================================
# Generate secure random strings for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production

# ===============================================
# API CONFIGURATION
# ===============================================
# CORS - Allowed origins for web browsers (comma-separated)
# Mobile apps don't need to be listed here!
# Leave empty or set to * to allow all origins
ALLOWED_ORIGINS=http://localhost:3000,https://civicsignal.rw,https://www.civicsignal.rw

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================================
# EMAIL SERVICE
# ===============================================
# Email provider settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@civicsignal.rw
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=CivicSignal <noreply@civicsignal.rw>

# ===============================================
# SMS SERVICE
# ===============================================
# SMS provider settings (e.g., Twilio, Africa's Talking)
SMS_PROVIDER=africas_talking
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_SENDER_ID=CivicSignal

# ===============================================
# FILE STORAGE
# ===============================================
# For issue photos and agency documents
STORAGE_PROVIDER=local
# Or use cloud storage:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# AWS_BUCKET=civicsignal-uploads

# ===============================================
# APPLICATION
# ===============================================
NODE_ENV=development
# NODE_ENV=production

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://civicsignal.rw

# API Base URL (for mobile apps)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_URL=https://api.civicsignal.rw/api

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
# TODO: Move admin credentials from code to environment variables
# ADMIN_EMAIL=admin@civicsignal.rw
# ADMIN_PASSWORD=secure-admin-password

# ===============================================
# SECURITY
# ===============================================
# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Session settings
SESSION_MAX_AGE=604800
# Token expiry (in seconds)
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# ===============================================
# MOBILE APP CONFIGURATION
# ===============================================
# Mobile app specific settings
MOBILE_APP_VERSION=1.0.0
MOBILE_API_KEY=optional-mobile-api-key-for-analytics

# ===============================================
# MONITORING & LOGGING
# ===============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
# LOG_LEVEL=error

# Error tracking (e.g., Sentry)
# SENTRY_DSN=your-sentry-dsn
# SENTRY_ENVIRONMENT=production

# ===============================================
# FEATURE FLAGS
# ===============================================
# Enable/disable features
ENABLE_ISSUE_TRACKING=true
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true
ENABLE_AGENCY_VERIFICATION=true

# ===============================================
# NOTES
# ===============================================
# 1. Never commit .env.local or .env files to version control
# 2. Use different values for development and production
# 3. Generate secure random strings for secrets
# 4. Mobile apps access APIs without CORS restrictions
# 5. ALLOWED_ORIGINS only affects web browser clients
